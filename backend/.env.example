NODE_ENV=development
PORT=5050
CLIENT_URL=http://127.0.0.1:5173
# Comma-separated list for production domains, for example:
# CLIENT_URLS=https://yourdomain.com,https://www.yourdomain.com
CLIENT_URLS=http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=replace_me
DB_SSL=false
# Optional hosted Postgres connection string. If set, it takes precedence over DB_HOST/DB_NAME/etc.
DATABASE_URL=

JWT_SECRET=replace_me_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=rew_session
MAX_JSON_BODY_SIZE=100kb
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_MAX_VIDEO_FILE_SIZE_MB=50
UPLOAD_MAX_FILES=10

ADMIN_NAME=Srinivas
ADMIN_PHONE=9849972116
ADMIN_EMAIL=akulasrinu62@gmail.com
ADMIN_PASSWORD=change_me

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=siddipet-real-estate

# Groq chatbot. Keep the real key only in backend/.env, never frontend code.
GROQ_CHATBOT_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Inquiry notifications
# Phones must include country code. Separate multiple recipients with commas.
INQUIRY_NOTIFICATION_PHONES=918897422872,919347332792

# WhatsApp Cloud API notifications. Set enabled to true after adding real Meta credentials.
WHATSAPP_NOTIFICATION_ENABLED=false
WHATSAPP_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Telegram Bot API notifications. Start your bot once before using your personal chat id.
TELEGRAM_NOTIFICATION_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email notifications. For Gmail, use an App Password, not your normal Gmail password.
EMAIL_NOTIFICATION_ENABLED=false
INQUIRY_NOTIFICATION_EMAIL=akulaakash17@gmail.com
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
